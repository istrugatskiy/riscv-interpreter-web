@precedence { argument @left }

@top
Program { ((space* newline) | Statement)* }

@skip { Comment }

Statement {
  (space* (LabelDef ":" space* | MacroExpr | (LabelDef ":" space* MacroExpr)) newline)
}

LabelDef {
  name | digit
}

MacroExpr {
  (MacroName space*) | (MacroName space+ ArgList space*)
}

ArgList {
  argument !argument (space* "," space* argument)*
}

MacroName { name }
LabelName { name | relative_label_ref }
ImmRegister {
  Immediate ~ambig space* "(" space* Register space* ")"
}

argument {
  ImmRegister 
  | LabelName
  | Immediate ~ambig
  | Register
}

Immediate {
  binary_immediate | non_binary_immediate 
}

@tokens {
  space { $[ \t] }
  Comment { "#" ![\n\r]* }
  newline { ("\n" | "\r\n" | "\r") }

  name { $[A-Za-z._$] $[A-Za-z0-9._$]* }
  digit { $[0-9] }
  relative_label_ref { $[0-9] ( "f" | "b") }

  Register {
    "x0"|"x1"|"x2"|"x3"|"x4"|"x5"|"x6"|"x7"|"x8"|"x9"|"x10"|"x11"|"x12"|"x13"|"x14"|"x15"|
    "x16"|"x17"|"x18"|"x19"|"x20"|"x21"|"x22"|"x23"|"x24"|"x25"|"x26"|"x27"|"x28"|"x29"|"x30"|"x31"|
    "zero"|"ra"|"sp"|"gp"|"tp"|"t0"|"t1"|"t2"|"s0"|"s1"|"a0"|"a1"|"a2"|"a3"|"a4"|"a5"|"a6"|"a7"|
    "s2"|"s3"|"s4"|"s5"|"s6"|"s7"|"s8"|"s9"|"s10"|"s11"|"t3"|"t4"|"t5"|"t6"|"fp"
  }

  non_binary_immediate {
    ("+"|"-")? ( "0x" $[0-9A-Fa-f]+
         | "0" $[0-7]+
         | $[0-9]+ )
  }

  binary_immediate { "0b" $[01]+ } 
  
  @precedence { Register, binary_immediate, relative_label_ref, non_binary_immediate, name, Comment, newline, space }
}