@precedence {
  argument @left
}

@top
Program { ((space* newline) | Statement)* }

@skip { comment }

Statement {
  (space*  (LabelDef | MacroExpr | (LabelDef space+ MacroExpr)) newline)
}

LabelDef {
  name ":"
}

MacroExpr {
  MacroName space+ ArgList?
}

ArgList {
  argument !argument (space* "," space* argument)*
}

MacroName { name }
LabelName { name }
ImmRegister {
  Immediate ~ambig space* "(" space* Register space* ")"
}

argument {
  ImmRegister 
  | LabelName
  | Immediate ~ambig
  | Register
}

@tokens {
  space { $[ \t\n\r]+ }
  comment { "#" ![\n\r]* }
  newline { space* ("\n" | "\r\n" | "\r") }

  name { $[A-Za-z._$] $[A-Za-z0-9._$]* }

  Register {
    "x0"|"x1"|"x2"|"x3"|"x4"|"x5"|"x6"|"x7"|"x8"|"x9"|"x10"|"x11"|"x12"|"x13"|"x14"|"x15"|
    "x16"|"x17"|"x18"|"x19"|"x20"|"x21"|"x22"|"x23"|"x24"|"x25"|"x26"|"x27"|"x28"|"x29"|"x30"|"x31"|
    "zero"|"ra"|"sp"|"gp"|"tp"|"t0"|"t1"|"t2"|"s0"|"s1"|"a0"|"a1"|"a2"|"a3"|"a4"|"a5"|"a6"|"a7"|
    "s2"|"s3"|"s4"|"s5"|"s6"|"s7"|"s8"|"s9"|"s10"|"s11"|"t3"|"t4"|"t5"|"t6"|"fp"
  }

  Immediate {
    ("+"|"-")? ( "0x" $[0-9A-Fa-f]+
         | "0b" $[01]+
         | "0" $[0-7]+
         | $[0-9]+ )
  }
  
  @precedence { Register, Immediate, name, comment, newline, space }
}