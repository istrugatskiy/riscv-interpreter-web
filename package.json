{
    "name": "riscv",
    "packageManager": "yarn@4.9.2",
    "dependencies": {
        "@babel/runtime": "^7.28.3",
        "@codemirror/language": "^6.10.3",
        "@codemirror/lint": "^6.8.5",
        "@istrugatskiy/riscv-highlighter": "workspace:^",
        "@istrugatskiy/riscv-parser": "workspace:^",
        "@istrugatskiy/riscv-vm": "workspace:^",
        "@lezer/common": "^1.2.3",
        "@lezer/highlight": "^1.2.1",
        "@parcel/core": "^2.15.4",
        "@uiw/codemirror-theme-material": "^4.25.1",
        "codemirror": "^6.0.2",
        "parcel": "^2.15.4",
        "typescript": "^5.9.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@parcel/config-default": "^2.15.4",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/emscripten": "^1.40.1",
        "buffer": "^6.0.3",
        "crypto-browserify": "^3.12.1",
        "eslint": "^9.33.0",
        "events": "^3.3.0",
        "parcel-reporter-static-files-copy": "^1.5.3",
        "path-browserify": "^1.0.1",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "process": "^0.11.10",
        "stream-browserify": "^3.0.0",
        "string_decoder": "^1.3.0",
        "tailwindcss": "^4.1.12",
        "typescript-eslint": "^8.40.0",
        "vitest": "^3.2.4",
        "vm-browserify": "^1.1.2"
    },
    "workspaces": [
        "riscv",
        "packages/*"
    ],
    "scripts": {
        "format": "yarn run prettier './{src,packages,@types}/**/*.{ts,html,css,md}'",
        "check": "yarn run tsc --noEmit && yarn run eslint",
        "dev": "yarn run parcel ./src/index.html",
        "clean": "rm -r ./dist/ && rm -r ./.parcel-cache/"
    }
}
